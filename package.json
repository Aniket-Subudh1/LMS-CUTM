{
  "name": "cutm-lms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "start:local": "cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/ && node --env-file-if-exists=.env --env-file-if-exists=.env.local .next/standalone/server.js",
    "start:e2e": "cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/ && node --env-file=.env.e2e .next/standalone/server.js",
    "worker": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server worker/index.ts",
    "worker:e2e": "tsx --env-file=.env.e2e --conditions=react-server worker/index.ts",
    "worker:dev": "tsx watch --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server worker/index.ts",
    "db:indexes:e2e": "tsx --env-file=.env.e2e --conditions=react-server scripts/sync-indexes.ts",
    "db:seed": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server scripts/seed.ts",
    "db:seed:e2e": "tsx --env-file=.env.e2e --conditions=react-server scripts/seed.ts --e2e",
    "db:indexes": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server scripts/sync-indexes.ts",
    "db:migrate:catalog-v2": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server scripts/migrate-catalog-v2.ts",
    "s3:setup": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server scripts/s3-setup.ts",
    "s3:setup:e2e": "tsx --env-file=.env.e2e --conditions=react-server scripts/s3-setup.ts",
    "admin:create": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server scripts/create-admin.ts",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test",
    "check:bundle": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check-bundle.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1149.0",
    "@aws-sdk/s3-request-presigner": "3.1149.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@livekit/components-react": "2.9.24",
    "@livekit/components-styles": "1.2.0",
    "@node-rs/argon2": "2.2.2",
    "@phosphor-icons/react": "2.1.10",
    "@tiptap/html": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "bullmq": "6.3.13",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "ffmpeg-static": "5.3.0",
    "gsap": "3.15.0",
    "happy-dom": "20.14.6",
    "ioredis": "6.0.0",
    "iron-session": "9.0.1",
    "livekit-client": "2.22.4",
    "livekit-server-sdk": "2.19.1",
    "mongoose": "9.11.1",
    "next": "16.4.0",
    "nodemailer": "10.1.0",
    "papaparse": "5.7.0",
    "qrcode": "1.5.4",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-is": "19.3.0",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/papaparse": "5.5.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "mongodb-memory-server": "11.3.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.0.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "mongodb-memory-server@11.3.0": true,
    "msgpackr-extract@3.0.4": true,
    "unrs-resolver@1.12.2": true,
    "ffmpeg-static@5.3.0": true
  }
}
