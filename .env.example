NODE_ENV=development
APP_URL=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017/lms_dev?replicaSet=rs0&directConnection=true
REDIS_URL=redis://localhost:6379
SESSION_PASSWORD=change-me-to-32-or-more-random-characters
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=cutm-lms
S3_ACCESS_KEY_ID=lmsdev
S3_SECRET_ACCESS_KEY=lmsdev-secret-key
S3_FORCE_PATH_STYLE=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="CUTM LMS <lms@localhost>"
COURSEWARE_URL=https://courseware.cutm.ac.in
# Live classes: the development keys in livekit.yaml (11 §3.1). Production uses its own pair.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_URL=http://localhost:7880
LIVEKIT_API_KEY=lmsdevkey
LIVEKIT_API_SECRET=lms-dev-livekit-secret-at-least-32-chars
# Code questions (M04b): Judge0's free public server until the university's own runs; then its URL and AUTHN_TOKEN.
CODE_RUNNER_URL=https://ce.judge0.com
# CODE_RUNNER_TOKEN=
# AI drafts of bank questions (M04b): the Anthropic API key. Leave it out and the AI helpers say they are not set up.
# ANTHROPIC_API_KEY=
LOG_LEVEL=info
# `npm run db:seed` only: uncomment (10+ characters) and every seeded account is active with this password.
# SEED_PASSWORD=
